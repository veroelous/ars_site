# Copie para .env.local (desenvolvimento) ou configure no painel da hospedagem.

# URL pública do site, sem barra no final (usada em metadados/SEO).
SITE_URL=https://www.arsiluminacao.com.br

# true em ambientes de teste (ex.: dev.arsiluminacao.com.br) para o Google não indexar.
SITE_NOINDEX=false

# Segredo para assinar o link temporário de download do catálogo.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CATALOG_TOKEN_SECRET=

# ---- Armazenamento de leads (catálogo e contato) ----
# "file"    → grava em LEADS_DIR (servidor Node/VPS com disco persistente)
# "webhook" → envia para LEADS_WEBHOOK_URL (Make, Zapier, n8n, Google Apps Script...)
# "both"    → faz os dois
LEADS_STORAGE=file
LEADS_DIR=./data
LEADS_WEBHOOK_URL=
# Opcional: enviado no cabeçalho "X-Webhook-Secret" para o destino validar a origem.
LEADS_WEBHOOK_SECRET=

# Acesso à exportação CSV dos leads em /api/admin/leads (autenticação HTTP Basic).
# Deixe em branco para desativar a rota.
ADMIN_USER=
ADMIN_PASSWORD=

# ---- Instagram (3 publicações mais recentes) ----
# Token de longa duração da Instagram API with Instagram Login (conta profissional @ars.iluminacao).
# Sem token, o site mostra as publicações definidas em config/instagram-fallback.ts.
INSTAGRAM_ACCESS_TOKEN=
# Tempo de cache do feed em segundos (padrão: 1 hora).
INSTAGRAM_REVALIDATE_SECONDS=3600
