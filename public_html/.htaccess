# ARS Iluminação — regras do Apache (cPanel)

Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Endereço único: sempre HTTPS e sem "www" (evita conteúdo duplicado no Google).
  # O HTTPS chega pelo proxy da Host4; X-Forwarded-Proto evita laço de redirecionamento.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # /index.php e /pasta/index.php respondem pela URL com barra (sem duplicar páginas).
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?]
  RewriteRule ^(.*/)?index\.php$ /$1 [R=301,L]

  # Pastas internas nunca são servidas diretamente.
  RewriteRule ^(includes|private)(/|$) - [F,L]

  # Catálogo: /produtos/<categoria>/ e /produtos/<categoria>/<produto>/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^produtos/([a-z0-9-]+)$ /produtos/$1/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^produtos/([a-z0-9-]+)/([a-z0-9-]+)$ /produtos/$1/$2/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^produtos/([a-z0-9-]+)/$ produtos/categoria.php?c=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^produtos/([a-z0-9-]+)/([a-z0-9-]+)/$ produtos/produto.php?c=$1&p=$2 [L,QSA]

  # robots.txt e sitemap.xml gerados conforme o domínio (dev.* não é indexado).
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  # Resumo do site para assistentes de IA (padrão llms.txt).
  RewriteRule ^llms\.txt$ llms.php [L]
</IfModule>

# Arquivos que não devem ser baixados.
<FilesMatch "\.(jsonl?|log|md|sh|ini|bak)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Endereço de teste: pede aos buscadores para não indexar.
  <If "%{HTTP_HOST} =~ /^dev\./">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
